{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entrotter result envelope 0.1.0",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "mode",
    "scenario",
    "baseline",
    "candidate",
    "comparison",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "fixture",
        "evm-local",
        "evm-fork"
      ]
    },
    "scenario": {
      "type": "object"
    },
    "baseline": {
      "type": "object",
      "required": [
        "metrics",
        "trace"
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "metrics",
        "trace"
      ]
    },
    "comparison": {
      "type": "object"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
