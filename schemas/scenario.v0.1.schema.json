{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entrotter.github.io/schemas/scenario.v0.1.schema.json",
  "title": "Entrotter scenario 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "mode",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "mode": {
      "enum": [
        "fixture",
        "evm-local",
        "evm-fork"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "local-evm",
            "historical-fork"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prices",
        "initial_cash",
        "initial_units",
        "fee_bps",
        "slippage_bps",
        "symbol"
      ],
      "properties": {
        "prices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$"
          }
        },
        "initial_cash": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$"
        },
        "initial_units": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$"
        },
        "fee_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "slippage_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]{1,12}$"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "hold",
            "circuit_breaker"
          ]
        },
        "drawdown_trigger": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "circuit_breaker"
              }
            }
          },
          "then": {
            "required": [
              "drawdown_trigger"
            ]
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "hold",
            "circuit_breaker"
          ]
        },
        "drawdown_trigger": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "circuit_breaker"
              }
            }
          },
          "then": {
            "required": [
              "drawdown_trigger"
            ]
          }
        }
      ]
    },
    "actor": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "actor_balance_wei": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "allowed_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      }
    },
    "local_contracts": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^0x(?:[0-9a-fA-F]{2}){1,4096}$"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "block_number"
      ],
      "properties": {
        "chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "block_number": {
          "type": "integer",
          "minimum": 1
        },
        "block_hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "baseline",
          "candidate"
        ],
        "properties": {
          "baseline": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/action"
              }
            ]
          },
          "candidate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/action"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "value_wei": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "data": {
          "type": "string",
          "pattern": "^0x(?:[0-9a-fA-F]{2}){0,16384}$"
        },
        "gas": {
          "type": "integer",
          "minimum": 21000,
          "maximum": 2000000
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "fixture"
          }
        }
      },
      "then": {
        "required": [
          "market",
          "baseline",
          "candidate"
        ],
        "properties": {
          "provenance": {
            "properties": {
              "kind": {
                "const": "synthetic"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "evm-local"
          }
        }
      },
      "then": {
        "required": [
          "actor",
          "actor_balance_wei",
          "allowed_targets",
          "steps"
        ],
        "properties": {
          "provenance": {
            "properties": {
              "kind": {
                "const": "local-evm"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "evm-fork"
          }
        }
      },
      "then": {
        "required": [
          "actor",
          "actor_balance_wei",
          "allowed_targets",
          "steps",
          "source"
        ],
        "properties": {
          "provenance": {
            "properties": {
              "kind": {
                "const": "historical-fork"
              }
            }
          }
        }
      }
    }
  ]
}
